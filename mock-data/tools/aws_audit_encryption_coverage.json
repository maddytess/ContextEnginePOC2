{
  "tool_id": "aws.audit_encryption_coverage",
  "name": "AWS Encryption Coverage Audit",
  "tool_class": "inventory_read",
  "tool_type": "readonly",
  "domain": [
    "security"
  ],
  "provider": "aws",
  "execution_location": "client",
  "safety_class": "read_only",
  "purpose": "Audit encryption at rest and in transit across S3, EBS, RDS, EFS, KMS, and ELB HTTPS enforcement.",
  "auth": null,
  "output_schema_ref": "schemas/encryption_finding.yaml",
  "cacheable": true,
  "resource_types": [
    "AWS::S3::Bucket",
    "AWS::EC2::Volume",
    "AWS::RDS::DBInstance",
    "AWS::EFS::FileSystem",
    "AWS::KMS::Key",
    "AWS::ElasticLoadBalancingV2::Listener"
  ],
  "api_calls": [
    "s3:GetBucketEncryption",
    "s3:GetBucketPolicy",
    "ec2:DescribeVolumes",
    "rds:DescribeDBInstances",
    "efs:DescribeFileSystems",
    "kms:ListKeys",
    "kms:DescribeKey",
    "elasticloadbalancing:DescribeListeners"
  ],
  "input_schema": {
    "parameters": [
      {
        "name": "scope",
        "type": "string",
        "required": false,
        "description": "all \u2014 full encryption audit"
      },
      {
        "name": "region",
        "type": "string",
        "required": false,
        "description": "AWS region or empty for all regions"
      },
      {
        "name": "profiles",
        "type": "string",
        "required": true,
        "description": "AWS profile name from Cloud Profile context"
      }
    ]
  },
  "execution_timeout": 45,
  "version": "0.1.0",
  "tenant_id": null
}