{
  "tool_id": "aws.run_pci_dss_audit",
  "name": "AWS PCI-DSS v4.0 Compliance Audit",
  "tool_class": "compliance_read",
  "tool_type": "readonly",
  "domain": [
    "compliance"
  ],
  "provider": "aws",
  "execution_location": "client",
  "safety_class": "read_only",
  "purpose": "Evaluate AWS against PCI-DSS v4.0 covering network security, cardholder data protection, access control, logging, and vulnerability management.",
  "auth": null,
  "output_schema_ref": "schemas/pci_dss_report.yaml",
  "cacheable": true,
  "resource_types": [
    "AWS::EC2::SecurityGroup",
    "AWS::EC2::NetworkAcl",
    "AWS::EC2::VPC",
    "AWS::S3::Bucket",
    "AWS::KMS::Key",
    "AWS::IAM::User",
    "AWS::CloudTrail::Trail",
    "AWS::GuardDuty::Detector",
    "AWS::WAFv2::WebACL",
    "AWS::ElasticLoadBalancingV2::LoadBalancer"
  ],
  "api_calls": [
    "ec2:DescribeSecurityGroups",
    "ec2:DescribeNetworkAcls",
    "ec2:DescribeVpcs",
    "s3:GetBucketEncryption",
    "kms:ListKeys",
    "iam:ListUsers",
    "iam:GetAccountPasswordPolicy",
    "cloudtrail:DescribeTrails",
    "guardduty:ListDetectors",
    "wafv2:ListWebACLs",
    "elasticloadbalancing:DescribeLoadBalancers"
  ],
  "input_schema": {
    "parameters": [
      {
        "name": "scope",
        "type": "string",
        "required": false,
        "description": "all \u2014 full PCI-DSS audit"
      },
      {
        "name": "region",
        "type": "string",
        "required": false,
        "description": "AWS region or empty for all regions"
      },
      {
        "name": "profiles",
        "type": "string",
        "required": true,
        "description": "AWS profile name from Cloud Profile context"
      }
    ]
  },
  "execution_timeout": 60,
  "version": "0.1.0",
  "tenant_id": null
}