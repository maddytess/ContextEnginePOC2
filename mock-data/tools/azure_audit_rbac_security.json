{
  "tool_id": "azure.audit_rbac_security",
  "name": "Azure RBAC Security Audit",
  "tool_class": "iam_read",
  "tool_type": "readonly",
  "domain": [
    "security"
  ],
  "provider": "azure",
  "execution_location": "client",
  "safety_class": "read_only",
  "purpose": "Audit Azure RBAC assignments, managed identities, and Key Vault access policies for security misconfigurations.",
  "auth": null,
  "output_schema_ref": "schemas/iam_security_finding.yaml",
  "cacheable": true,
  "resource_types": [
    "Microsoft.Authorization/roleAssignments",
    "Microsoft.Authorization/roleDefinitions",
    "Microsoft.ManagedIdentity/userAssignedIdentities",
    "Microsoft.KeyVault/vaults"
  ],
  "api_calls": [
    "Microsoft.Authorization/roleAssignments/read",
    "Microsoft.Authorization/roleDefinitions/read",
    "Microsoft.ManagedIdentity/userAssignedIdentities/read",
    "Microsoft.KeyVault/vaults/read",
    "Microsoft.KeyVault/vaults/accessPolicies/write"
  ],
  "input_schema": {
    "parameters": [
      {
        "name": "scope",
        "type": "string",
        "required": false,
        "description": "all \u2014 full RBAC audit"
      },
      {
        "name": "profiles",
        "type": "string",
        "required": true,
        "description": "Azure profile name from Cloud Profile context"
      }
    ]
  },
  "execution_timeout": 60,
  "version": "0.1.0",
  "tenant_id": null
}