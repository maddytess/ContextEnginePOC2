{
  "tool_id": "azure.run_soc2_audit",
  "name": "Azure SOC 2 Compliance Audit",
  "tool_class": "compliance_read",
  "tool_type": "readonly",
  "domain": [
    "compliance"
  ],
  "provider": "azure",
  "execution_location": "client",
  "safety_class": "read_only",
  "purpose": "Evaluate Azure infrastructure against SOC 2 Trust Service Criteria and return a structured compliance report.",
  "auth": null,
  "output_schema_ref": "schemas/compliance_report.yaml",
  "cacheable": true,
  "resource_types": [
    "Microsoft.Authorization/roleAssignments",
    "Microsoft.KeyVault/vaults",
    "Microsoft.Security/securityContacts",
    "Microsoft.Storage/storageAccounts",
    "Microsoft.Insights/diagnosticSettings"
  ],
  "api_calls": [
    "Microsoft.Authorization/roleAssignments/read",
    "Microsoft.KeyVault/vaults/read",
    "Microsoft.Security/securityContacts/read",
    "Microsoft.Storage/storageAccounts/read",
    "Microsoft.Insights/diagnosticSettings/read"
  ],
  "input_schema": {
    "parameters": [
      {
        "name": "scope",
        "type": "string",
        "required": false,
        "description": "all \u2014 full account audit"
      },
      {
        "name": "profiles",
        "type": "string",
        "required": true,
        "description": "Azure profile name from Cloud Profile context"
      }
    ]
  },
  "execution_timeout": 60,
  "version": "0.1.0",
  "tenant_id": null
}